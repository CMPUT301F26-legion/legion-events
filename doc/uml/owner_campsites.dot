// UML class diagram: owner campsites (Person 3)
// Render with: python3 render.py owner_campsites.dot owner_campsites.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Owner campsites" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  Campsite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Campsite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ name: String<BR/>+ locationName: String<BR/>+ maxGuests: Int<BR/>+ pricePerNight: Long<BR/>+ description: String<BR/>+ amenities: List&lt;String&gt;<BR/>+ tags: List&lt;String&gt;<BR/>+ location: GeoPoint?<BR/>+ rules: List&lt;String&gt;<BR/>+ cancellationPolicy: String<BR/>+ availableNights: List&lt;String&gt;<BR/>+ photoId: String?<BR/>+ ratingAverage: Double<BR/>+ ratingCount: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Photo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Photo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ targetType: String<BR/>+ targetId: String<BR/>+ imageBase64: String<BR/>+ mimeType: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryBadge [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>LotteryBadge</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ OPEN: LotteryBadge<BR/>+ UPCOMING: LotteryBadge<BR/>+ CLOSED: LotteryBadge<BR/>+ DRAWN: LotteryBadge<BR/>+ NONE: LotteryBadge<BR/>+ label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ lotteryBadge(campsiteId, lotteries, now): LotteryBadge<BR/>~ lotteryBadge(lottery, now): LotteryBadge</TD></TR></TABLE>>];
  OwnerCampsiteRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>OwnerCampsiteRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getMyCampsites(): List&lt;Campsite&gt;<BR/>+ getMyCampsite(campsiteId: String): Campsite?<BR/>+ getMyLotteries(): List&lt;Lottery&gt;<BR/>+ getPhotos(photoIds: List&lt;String&gt;): List&lt;Photo&gt;<BR/>+ saveCampsite(campsite: Campsite, coverJpegBase64: String?): String</TD></TR></TABLE>>];
  FirebaseOwnerCampsiteRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseOwnerCampsiteRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getMyCampsites(): List&lt;Campsite&gt;<BR/>+ getMyCampsite(campsiteId: String): Campsite?<BR/>+ getMyLotteries(): List&lt;Lottery&gt;<BR/>+ getPhotos(photoIds: List&lt;String&gt;): List&lt;Photo&gt;<BR/>+ saveCampsite(campsite: Campsite, coverJpegBase64: String?): String<BR/>- commitWithCover(...)<BR/>- logFailure(what: String, write)<BR/>- ownerId(): String</TD></TR></TABLE>>];
  CoverPhotoNotSavedException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«exception»</I><BR/><B>CoverPhotoNotSavedException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ campsiteId: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerDashboardController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>OwnerDashboardController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- repository: OwnerCampsiteRepository<BR/>- now: () -&gt; Long<BR/>- mutableState: MutableStateFlow&lt;OwnerDashboardState&gt;<BR/>+ state: StateFlow&lt;OwnerDashboardState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>- loadCovers(campsites: List&lt;Campsite&gt;)</TD></TR></TABLE>>];
  OwnerDashboardState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerDashboardState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ campsites: List&lt;OwnerCampsiteItem&gt;<BR/>+ openLotteries: Int<BR/>+ lotteriesUnavailable: Boolean<BR/>+ covers: Map&lt;String, Photo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerCampsiteItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerCampsiteItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ campsite: Campsite<BR/>+ badge: LotteryBadge?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteEditController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>CampsiteEditController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- campsiteId: String?<BR/>- repository: OwnerCampsiteRepository<BR/>- mutableState: MutableStateFlow&lt;CampsiteEditState&gt;<BR/>+ state: StateFlow&lt;CampsiteEditState&gt;<BR/>- request: Job?<BR/>- original: Campsite?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()<BR/>+ setName(), setLocationName(), setDescription()<BR/>+ toggleAmenity(amenity: String)<BR/>+ setTagInput(), addTag(), removeTag(tag: String)<BR/>+ setMaxGuests(), setPrice()<BR/>+ setLatitude(), setLongitude()<BR/>+ startLocating(), setCurrentLocation(lat, lng), locationFailed(message)<BR/>+ setRules(), setCancellationPolicy()<BR/>+ setOpenFrom(day), setOpenUntil(day)<BR/>+ startPhoto(), setPhoto(base64Jpeg: String?), removePhoto()<BR/>+ save()<BR/>- prefill(site: Campsite): CampsiteEditState<BR/>- edit(field, change)</TD></TR></TABLE>>];
  CampsiteEditState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>CampsiteEditState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ campsiteId: String?<BR/>+ loading: Boolean, loadError: String?<BR/>+ name, locationName, description: String<BR/>+ amenities: Set&lt;String&gt;, tags: List&lt;String&gt;, tagInput: String<BR/>+ maxGuests, price: String<BR/>+ latitude, longitude: String, locating: Boolean<BR/>+ rules, cancellationPolicy: String<BR/>+ openFrom, openUntil: String<BR/>+ newPhoto: String?, hasCover: Boolean<BR/>+ errors: Map&lt;CampsiteField, String&gt;<BR/>+ saving: Boolean, message: String?<BR/>+ savedCampsiteId: String?<BR/>+ editing: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteField [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>CampsiteField</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ NAME: CampsiteField<BR/>+ LOCATION: CampsiteField<BR/>+ DESCRIPTION: CampsiteField<BR/>+ GUESTS: CampsiteField<BR/>+ PRICE: CampsiteField<BR/>+ COORDINATES: CampsiteField<BR/>+ TAG: CampsiteField<BR/>+ label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerCampsiteController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>OwnerCampsiteController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- campsiteId: String<BR/>- repository: OwnerCampsiteRepository<BR/>- now: () -&gt; Long<BR/>- mutableState: MutableStateFlow&lt;OwnerCampsiteState&gt;<BR/>+ state: StateFlow&lt;OwnerCampsiteState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ generateQr()</TD></TR></TABLE>>];
  OwnerCampsiteState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerCampsiteState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ campsite: Campsite?<BR/>+ badge: LotteryBadge?<BR/>+ cover: Photo?<BR/>+ qrText: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteQr [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«object»</I><BR/><B>CampsiteQr</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ PREFIX = "legionevents://campsite/"</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ encode(campsiteId: String): String<BR/>+ decode(text: String): String?</TD></TR></TABLE>>];
  QrCodeImage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» QrCodeImage.kt</I><BR/><B>QrCodeImage</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ createQrBitmap(text: String, size: Int): Bitmap<BR/>~ writeQrPng(bitmap: Bitmap, out: OutputStream)<BR/>~ cacheQrPng(context, bitmap, campsiteId): Uri</TD></TR></TABLE>>];
  PhotoEncoder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» PhotoEncoder.kt</I><BR/><B>PhotoEncoder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ encodeCampsitePhoto(resolver, uri): String?<BR/>- exifRotation(exif): Float<BR/>- scaleAndRotate(bitmap, rotation): Bitmap</TD></TR></TABLE>>];
  DeviceLocation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» DeviceLocation.kt</I><BR/><B>DeviceLocation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ hasLocationPermission(context): Boolean<BR/>~ currentLocation(context): Location?</TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>Owner campsite screens</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ OwnerDashboardScreen(...)<BR/>+ CampsiteEditScreen(state, actions)<BR/>+ OwnerCampsiteScreen(...)<BR/>~ BackArrow, LotteryBadgeChip, StatTile, CampsiteCover</TD></TR></TABLE>>];
  FirebaseOwnerCampsiteRepository -> OwnerCampsiteRepository [arrowhead=onormal];
  FirebaseOwnerCampsiteRepository -> CoverPhotoNotSavedException [arrowhead=vee label="throws" taillabel="1" headlabel="0..1"];
  OwnerCampsiteRepository -> Campsite [arrowhead=vee label="returns / saves" taillabel="0..*" headlabel="0..*"];
  OwnerCampsiteRepository -> Photo [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  Campsite -> Photo [arrowhead=none label="cover" taillabel="1" headlabel="0..1"];
  OwnerDashboardController -> OwnerCampsiteRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  OwnerDashboardController -> OwnerDashboardState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  OwnerDashboardState -> OwnerCampsiteItem [dir=back arrowtail=diamond label="campsites" taillabel="1" headlabel="0..*"];
  OwnerCampsiteItem -> Campsite [dir=back arrowtail=odiamond label="campsite" taillabel="0..*" headlabel="1"];
  OwnerCampsiteItem -> LotteryBadge [arrowhead=vee label="badge" taillabel="0..*" headlabel="0..1"];
  CampsiteEditController -> OwnerCampsiteRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  CampsiteEditController -> CampsiteEditState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  CampsiteEditState -> CampsiteField [arrowhead=vee label="errors" taillabel="0..*" headlabel="0..*"];
  OwnerCampsiteController -> OwnerCampsiteRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  OwnerCampsiteController -> OwnerCampsiteState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  OwnerCampsiteState -> Campsite [dir=back arrowtail=odiamond label="campsite" taillabel="1" headlabel="0..1"];
  OwnerCampsiteState -> LotteryBadge [arrowhead=vee label="badge" taillabel="0..*" headlabel="0..1"];
  OwnerCampsiteController -> CampsiteQr [arrowhead=vee label="encodes with" taillabel="0..*" headlabel="1"];
  Views -> OwnerDashboardState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> CampsiteEditState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> OwnerCampsiteState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> QrCodeImage [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
  Views -> PhotoEncoder [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
  Views -> DeviceLocation [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
}

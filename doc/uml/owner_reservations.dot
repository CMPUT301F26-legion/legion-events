// UML class diagram: owner reservations (S17)
// Render with: python3 render.py owner_reservations.dot owner_reservations.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Owner reservations" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  Reservation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Reservation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id, lotteryId, offerId: String<BR/>+ campsiteId, userId, ownerId: String<BR/>+ startDate, endDate: Timestamp<BR/>+ guestCount: Int<BR/>+ totalPrice: Long<BR/>+ rulesAccepted: Boolean<BR/>+ status: String<BR/>+ cancellationRequested: Boolean<BR/>+ createdAt, updatedAt: Timestamp?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ isActive(at: Timestamp): Boolean<BR/>+ isPast(at: Timestamp): Boolean<BR/>+ isUpcomingForOwner(at: Timestamp): Boolean<BR/>+ canOwnerAccept(at: Timestamp): Boolean<BR/>+ isCancelled(): Boolean<BR/>+ bookedNights(): List&lt;String&gt;</TD></TR></TABLE>>];
  ReservationText [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» Reservation.kt, BookingCalendar.kt</I><BR/><B>Reservation helpers</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ rejectionNotice(reservation, campsiteName, reason): String<BR/>+ monthOf(at: Timestamp): String<BR/>+ shiftMonth(month: String, by: Int): String<BR/>+ calendarCells(month: String): List&lt;String?&gt;<BR/>+ monthTitle(month: String): String</TD></TR></TABLE>>];
  OwnerReservationRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>OwnerReservationRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getCampsiteReservations(campsiteId: String): List&lt;Reservation&gt;<BR/>+ acceptReservation(reservationId: String)<BR/>+ rejectReservation(reservationId: String, reason: String?)</TD></TR></TABLE>>];
  FirebaseOwnerReservationRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseOwnerReservationRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore<BR/>- now: () -&gt; Timestamp</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getCampsiteReservations(campsiteId: String): List&lt;Reservation&gt;<BR/>+ acceptReservation(reservationId: String)<BR/>+ rejectReservation(reservationId: String, reason: String?)<BR/>- currentUserId(): String<BR/>- checkAccount(ownerId: String)</TD></TR></TABLE>>];
  OwnerCampsiteRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>OwnerCampsiteRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getMyCampsites(): List&lt;Campsite&gt;<BR/>...</TD></TR></TABLE>>];
  OwnerReservationTab [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>OwnerReservationTab</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ ACTIVE: OwnerReservationTab<BR/>+ PAST: OwnerReservationTab<BR/>+ CANCELLED: OwnerReservationTab</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  RejectionDraft [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>RejectionDraft</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ reservation: Reservation<BR/>+ reason: String<BR/>+ inProgress: Boolean<BR/>+ error: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerReservationsState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerReservationsState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean, error: String?<BR/>+ campsites: List&lt;Campsite&gt;<BR/>+ selectedCampsiteId: String?<BR/>+ active, past, cancelled: List&lt;Reservation&gt;<BR/>+ bookedNights, requestedNights: Set&lt;String&gt;<BR/>+ month: String<BR/>+ selectedTab: OwnerReservationTab<BR/>+ viewing: Reservation?<BR/>+ rejecting: RejectionDraft?<BR/>+ accepting, actionError: String?<BR/>+ result: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ visibleEntries(): List&lt;Reservation&gt;</TD></TR></TABLE>>];
  OwnerReservationsController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>OwnerReservationsController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- loadCampsites: suspend () -&gt; List&lt;Campsite&gt;<BR/>- repository: OwnerReservationRepository<BR/>- savedState: SavedStateHandle<BR/>- now: () -&gt; Timestamp<BR/>- mutableState: MutableStateFlow&lt;OwnerReservationsState&gt;<BR/>+ state: StateFlow&lt;OwnerReservationsState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ selectCampsite(campsiteId: String)<BR/>+ selectTab(tab: OwnerReservationTab)<BR/>+ showMonth(by: Int)<BR/>+ viewBooking(entry), closeBooking()<BR/>+ accept(entry)<BR/>+ requestReject(entry), setRejectReason(reason: String)<BR/>+ confirmReject(), cancelReject()<BR/>- load(block), choose(campsiteId), loadBookings(campsiteId)</TD></TR></TABLE>>];
  OwnerReservationsActions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerReservationsActions</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ onRefresh, onCloseView, onConfirmReject, onCancelReject: () -&gt; Unit<BR/>+ onSelectCampsite, onReason: (String) -&gt; Unit<BR/>+ onTab: (OwnerReservationTab) -&gt; Unit<BR/>+ onMonth: (Int) -&gt; Unit<BR/>+ onView, onReject: (Reservation) -&gt; Unit</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>OwnerReservationsScreen</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ OwnerReservationsScreen(state, actions)<BR/>- CampsiteMenu, BookingCalendar, DayCell, BookingTabs<BR/>- BookingCard, StatusBadge, BookingDialog, RejectDialog</TD></TR></TABLE>>];

  FirebaseOwnerReservationRepository -> OwnerReservationRepository [arrowhead=onormal];
  OwnerReservationRepository -> Reservation [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  FirebaseOwnerReservationRepository -> ReservationText [arrowhead=vee label="writes notice with" taillabel="0..*" headlabel="1"];
  OwnerReservationsController -> OwnerReservationRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  OwnerReservationsController -> OwnerCampsiteRepository [arrowhead=vee label="getMyCampsites" taillabel="0..*" headlabel="1"];
  OwnerReservationsController -> OwnerReservationsState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  OwnerReservationsController -> ReservationText [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
  OwnerReservationsState -> Reservation [dir=back arrowtail=odiamond label="lists" taillabel="1" headlabel="0..*"];
  OwnerReservationsState -> RejectionDraft [dir=back arrowtail=diamond label="rejecting" taillabel="1" headlabel="0..1"];
  OwnerReservationsState -> OwnerReservationTab [arrowhead=vee label="selectedTab" taillabel="0..*" headlabel="1"];
  Views -> OwnerReservationsState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> OwnerReservationsActions [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
  Views -> ReservationText [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
  OwnerReservationsActions -> OwnerReservationsController [arrowhead=vee label="forwards to" taillabel="0..*" headlabel="1"];
}

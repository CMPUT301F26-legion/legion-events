// UML class diagram: admin moderation (Person 1)
// Render with: python3 render.py admin_moderation.dot admin_moderation.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Admin moderation" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  Campsite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Campsite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ name: String<BR/>+ locationName: String<BR/>+ maxGuests: Int<BR/>+ pricePerNight: Long<BR/>+ photoId: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  UserProfile [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>UserProfile</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ uid: String<BR/>+ name: String<BR/>+ email: String<BR/>+ phone: String<BR/>+ role: String<BR/>+ disabled: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Photo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Photo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ imageBase64: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  ModeratedCampsite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>ModeratedCampsite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ campsite: Campsite<BR/>+ active: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  AdminRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>AdminRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getCampsites(): List&lt;ModeratedCampsite&gt;<BR/>+ getCampsite(campsiteId: String): ModeratedCampsite?<BR/>+ getProfiles(): List&lt;UserProfile&gt;<BR/>+ getProfile(userId: String): UserProfile?<BR/>+ removeCampsite(campsiteId: String)<BR/>+ removeProfile(userId: String)<BR/>+ removeOwner(userId: String): Int</TD></TR></TABLE>>];
  FirebaseAdminRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseAdminRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- firestore: FirebaseFirestore<BR/>- CAMPSITES = "campsites"<BR/>- USERS = "users"<BR/>+ instance: FirebaseAdminRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getCampsites(): List&lt;ModeratedCampsite&gt;<BR/>+ getCampsite(campsiteId: String): ModeratedCampsite?<BR/>+ getProfiles(): List&lt;UserProfile&gt;<BR/>+ getProfile(userId: String): UserProfile?<BR/>+ removeCampsite(campsiteId: String)<BR/>+ removeProfile(userId: String)<BR/>+ removeOwner(userId: String): Int<BR/>- removedCampsite(): Map&lt;String, Any&gt;<BR/>- disabledProfile(): Map&lt;String, Any&gt;</TD></TR></TABLE>>];
  CampsiteDetailsRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>CampsiteDetailsRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getCampsitePhotos(campsiteId: String, coverPhotoId: String?): List&lt;Photo&gt;</TD></TR></TABLE>>];
  AdminCampsitesController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>AdminCampsitesController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- admin: AdminRepository<BR/>- mutableState: MutableStateFlow&lt;AdminCampsitesState&gt;<BR/>+ state: StateFlow&lt;AdminCampsitesState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ setQuery(query: String)</TD></TR></TABLE>>];
  AdminCampsitesState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>AdminCampsitesState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ query: String<BR/>+ rows: List&lt;AdminCampsiteRow&gt;<BR/>+ shown: List&lt;AdminCampsiteRow&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  AdminCampsiteRow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>AdminCampsiteRow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ listing: ModeratedCampsite<BR/>+ ownerName: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  AdminCampsiteController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>AdminCampsiteController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- campsiteId: String<BR/>- admin: AdminRepository<BR/>- details: CampsiteDetailsRepository<BR/>- mutableState: MutableStateFlow&lt;AdminCampsiteState&gt;<BR/>+ state: StateFlow&lt;AdminCampsiteState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ requestRemove()<BR/>+ cancelRemove()<BR/>+ confirmRemove()</TD></TR></TABLE>>];
  AdminCampsiteState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>AdminCampsiteState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ listing: ModeratedCampsite?<BR/>+ ownerName: String<BR/>+ cover: Photo?<BR/>+ confirmingRemove: Boolean<BR/>+ removing: Boolean<BR/>+ actionError: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  AdminProfilesController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>AdminProfilesController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- admin: AdminRepository<BR/>- mutableState: MutableStateFlow&lt;AdminProfilesState&gt;<BR/>+ state: StateFlow&lt;AdminProfilesState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ setQuery(query: String)<BR/>+ requestRemoveProfile(userId: String)<BR/>+ requestRemoveOwner(userId: String)<BR/>+ cancelRemove()<BR/>+ confirmRemove()<BR/>- askToRemove(userId: String, withCampsites: Boolean)</TD></TR></TABLE>>];
  AdminProfilesState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>AdminProfilesState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ query: String<BR/>+ rows: List&lt;AdminProfileRow&gt;<BR/>+ confirming: PendingRemoval?<BR/>+ removing: Boolean<BR/>+ result: String?<BR/>+ actionError: String?<BR/>+ shown: List&lt;AdminProfileRow&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  AdminProfileRow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>AdminProfileRow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ profile: UserProfile<BR/>+ activeCampsites: Int<BR/>+ admin: Boolean<BR/>+ roleLabel: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  PendingRemoval [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>PendingRemoval</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ userId: String<BR/>+ name: String<BR/>+ withCampsites: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  AdminKt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» AdminCampsitesController.kt, AdminProfilesController.kt</I><BR/><B>AdminLabels</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ ownerLabel(name: String?): String<BR/>~ displayName(profile: UserProfile): String</TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>Admin dashboard screens (S19)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ AdminCampsitesScreen(state, onBack, onQuery, onRetry, onCampsite)<BR/>+ AdminCampsiteScreen(state, onBack, onRetry, onRemove, onConfirmRemove, onCancelRemove)<BR/>+ AdminProfilesScreen(state, onBack, onQuery, onRetry, onRemoveProfile, onRemoveOwner, onConfirmRemove, onCancelRemove)<BR/>~ AdminHeader(title, onBack)<BR/>~ AdminCard(modifier, content)<BR/>~ AdminPill(text, container, content)<BR/>~ RemovedPill()<BR/>~ AdminLoading(text)</TD></TR></TABLE>>];
  FirebaseAdminRepository -> AdminRepository [arrowhead=onormal];
  ModeratedCampsite -> Campsite [dir=back arrowtail=odiamond label="campsite" taillabel="0..1" headlabel="1"];
  AdminRepository -> ModeratedCampsite [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  AdminRepository -> UserProfile [arrowhead=vee label="returns / disables" taillabel="0..*" headlabel="0..*"];
  Campsite -> UserProfile [arrowhead=none label="owned by (ownerId)" taillabel="0..*" headlabel="1"];
  CampsiteDetailsRepository -> Photo [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  AdminCampsitesController -> AdminRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  AdminCampsitesController -> AdminCampsitesState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  AdminCampsitesState -> AdminCampsiteRow [dir=back arrowtail=odiamond label="rows" taillabel="1" headlabel="0..*"];
  AdminCampsiteRow -> ModeratedCampsite [dir=back arrowtail=odiamond label="listing" taillabel="0..*" headlabel="1"];
  AdminCampsiteController -> AdminRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  AdminCampsiteController -> CampsiteDetailsRepository [arrowhead=vee label="reads photos" taillabel="0..*" headlabel="1"];
  AdminCampsiteController -> AdminCampsiteState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  AdminCampsiteState -> ModeratedCampsite [dir=back arrowtail=odiamond label="listing" taillabel="0..*" headlabel="0..1"];
  AdminCampsiteState -> Photo [dir=back arrowtail=odiamond label="cover" taillabel="0..*" headlabel="0..1"];
  AdminProfilesController -> AdminRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  AdminProfilesController -> AdminProfilesState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  AdminProfilesState -> AdminProfileRow [dir=back arrowtail=odiamond label="rows" taillabel="1" headlabel="0..*"];
  AdminProfilesState -> PendingRemoval [dir=back arrowtail=diamond label="confirming" taillabel="1" headlabel="0..1"];
  AdminProfileRow -> UserProfile [dir=back arrowtail=odiamond label="profile" taillabel="0..*" headlabel="1"];
  AdminCampsitesController -> AdminKt [arrowhead=vee label="names owners" taillabel="0..*" headlabel="1"];
  AdminProfilesController -> AdminKt [arrowhead=vee label="names profiles" taillabel="0..*" headlabel="1"];
  Views -> AdminCampsitesState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> AdminCampsiteState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> AdminProfilesState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
}

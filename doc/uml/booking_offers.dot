// UML class diagram: booking offers and decline (Person 6)
// Render with: python3 render.py booking_offers.dot booking_offers.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Booking offers" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  BookingOffer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>BookingOffer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ lotteryId: String<BR/>+ userId: String<BR/>+ status: String<BR/>+ expiresAt: Timestamp?<BR/>+ createdAt: Timestamp?<BR/>+ updatedAt: Timestamp?<BR/>+ STATUS_OPEN: String<BR/>+ STATUS_USED: String<BR/>+ STATUS_DECLINED: String<BR/>+ STATUS_EXPIRED: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Lottery [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Lottery</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  UserProfile [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>UserProfile</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ uid: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OfferRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>OfferRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getOffer(offerId: String): BookingOffer?<BR/>+ getOffersForCurrentUser(): List&lt;BookingOffer&gt;<BR/>+ declineOffer(offerId: String): BookingOffer</TD></TR></TABLE>>];
  FirebaseOfferRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseOfferRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore<BR/>- now: () -&gt; Timestamp<BR/>- COLLECTION = "offers"</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getOffer(offerId: String): BookingOffer?<BR/>+ getOffersForCurrentUser(): List&lt;BookingOffer&gt;<BR/>+ declineOffer(offerId: String): BookingOffer<BR/>- currentUserId(): String<BR/>- offerDocument(offerId: String): DocumentReference<BR/>- DocumentSnapshot.toOwnedOffer(userId: String): BookingOffer<BR/>- DocumentSnapshot.requiredString(field: String): String<BR/>- DocumentSnapshot.optionalTimestamp(field: String): Timestamp?<BR/>- withOfferAccess(operation): T</TD></TR></TABLE>>];
  BookingOffersController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>BookingOffersController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- repository: OfferRepository<BR/>- mutableState: MutableStateFlow&lt;BookingOffersState&gt;<BR/>+ state: StateFlow&lt;BookingOffersState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()</TD></TR></TABLE>>];
  BookingOffersState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>BookingOffersState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ offers: List&lt;BookingOffer&gt;<BR/>+ loading: Boolean<BR/>+ error: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  BookingOfferController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>BookingOfferController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- offerId: String<BR/>- repository: OfferRepository<BR/>- now: () -&gt; Timestamp<BR/>- mutableState: MutableStateFlow&lt;BookingOfferState&gt;<BR/>+ state: StateFlow&lt;BookingOfferState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()<BR/>+ requestDecline()<BR/>+ cancelDecline()<BR/>+ confirmDecline()<BR/>- isExpired(offer: BookingOffer?): Boolean<BR/>- expireBeforeAction(): Boolean</TD></TR></TABLE>>];
  BookingOfferState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>BookingOfferState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ offer: BookingOffer?<BR/>+ loading: Boolean<BR/>+ declining: Boolean<BR/>+ confirming: Boolean<BR/>+ expired: Boolean<BR/>+ error: String?<BR/>+ actionError: String?<BR/>+ canDecline: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>Offer screens</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ LotteriesScreen(onOffers)<BR/>+ BookingOffersScreen(state, onBack, onRetry, onOpen)<BR/>+ BookingOfferScreen(state, onBack, onRetry, onDecline, onConfirmDecline, onCancelDecline)</TD></TR></TABLE>>];
  FirebaseOfferRepository -> OfferRepository [arrowhead=onormal];
  OfferRepository -> BookingOffer [arrowhead=vee label="returns / declines" taillabel="0..*" headlabel="0..*"];
  BookingOffer -> Lottery [arrowhead=none label="from" taillabel="0..*" headlabel="1"];
  BookingOffer -> UserProfile [arrowhead=none label="offered to" taillabel="0..*" headlabel="1"];
  BookingOffersController -> OfferRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  BookingOffersController -> BookingOffersState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  BookingOffersState -> BookingOffer [dir=back arrowtail=odiamond label="offers" taillabel="1" headlabel="0..*"];
  BookingOfferController -> OfferRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  BookingOfferController -> BookingOfferState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  BookingOfferState -> BookingOffer [dir=back arrowtail=odiamond label="offer" taillabel="1" headlabel="0..1"];
  Views -> BookingOffersState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> BookingOfferState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
}

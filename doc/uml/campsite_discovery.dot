// UML class diagram: campsite discovery and QR scanning (Person 2)
// Render with: python3 render.py campsite_discovery.dot campsite_discovery.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Campsite discovery" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  Campsite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Campsite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ name: String<BR/>+ locationName: String<BR/>+ maxGuests: Int<BR/>+ pricePerNight: Long<BR/>+ description: String<BR/>+ amenities: List&lt;String&gt;<BR/>+ tags: List&lt;String&gt;<BR/>+ location: GeoPoint?<BR/>+ rules: List&lt;String&gt;<BR/>+ cancellationPolicy: String<BR/>+ availableNights: List&lt;String&gt;<BR/>+ photoId: String?<BR/>+ ratingAverage: Double<BR/>+ ratingCount: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Photo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Photo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ targetType: String<BR/>+ targetId: String<BR/>+ imageBase64: String<BR/>+ mimeType: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteQr [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«object»</I><BR/><B>CampsiteQr</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ PREFIX = "legionevents://campsite/"</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ encode(campsiteId: String): String<BR/>+ decode(text: String): String?</TD></TR></TABLE>>];
  CampsiteRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>CampsiteRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ observeCampsites(): Flow&lt;List&lt;Campsite&gt;&gt;</TD></TR></TABLE>>];
  CampsiteDetailsRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>CampsiteDetailsRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getCampsite(campsiteId: String): Campsite?<BR/>+ getCampsitePhotos(campsiteId: String, coverPhotoId: String?): List&lt;Photo&gt;</TD></TR></TABLE>>];
  FirebaseRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ observeCampsites(): Flow&lt;List&lt;Campsite&gt;&gt;<BR/>+ getCampsite(campsiteId: String): Campsite?<BR/>+ getCampsitePhotos(campsiteId: String, coverPhotoId: String?): List&lt;Photo&gt;<BR/>- readCampsite(document): Campsite<BR/>+ initializeUser(): UserProfile</TD></TR></TABLE>>];
  CampsiteListController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>CampsiteListController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- repository: CampsiteRepository<BR/>- savedState: SavedStateHandle<BR/>- mutableState: MutableStateFlow&lt;CampsiteListState&gt;<BR/>+ state: StateFlow&lt;CampsiteListState&gt;<BR/>- listener: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ search(query: String)<BR/>+ filter(filter: CampsiteFilter)<BR/>+ retry()</TD></TR></TABLE>>];
  CampsiteListState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>CampsiteListState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ campsites: List&lt;Campsite&gt;<BR/>+ query: String<BR/>+ filter: CampsiteFilter<BR/>+ loading: Boolean<BR/>+ error: String?<BR/>+ visible: List&lt;Campsite&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteFilter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>CampsiteFilter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ ALL: CampsiteFilter<BR/>+ GROUPS: CampsiteFilter<BR/>+ BUDGET: CampsiteFilter</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteDetailsController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>CampsiteDetailsController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- campsiteId: String<BR/>- repository: CampsiteDetailsRepository<BR/>- mutableState: MutableStateFlow&lt;CampsiteDetailsState&gt;<BR/>+ state: StateFlow&lt;CampsiteDetailsState&gt;<BR/>- request: Job?<BR/>- photoRequest: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()<BR/>+ retryPhotos()</TD></TR></TABLE>>];
  CampsiteDetailsState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>CampsiteDetailsState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ campsite: Campsite?<BR/>+ loading: Boolean<BR/>+ error: String?<BR/>+ photos: List&lt;Photo&gt;<BR/>+ photosLoading: Boolean<BR/>+ photosError: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  QrScanController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>QrScanController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- savedState: SavedStateHandle<BR/>- mutableState: MutableStateFlow&lt;QrScanState&gt;<BR/>+ state: StateFlow&lt;QrScanState&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ scanStarted()<BR/>+ scanResult(text: String?)<BR/>+ cameraFailed(permissionDenied: Boolean)<BR/>+ retry()<BR/>- update(status: QrScanStatus, campsiteId: String?)</TD></TR></TABLE>>];
  QrScanState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>QrScanState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ status: QrScanStatus<BR/>+ campsiteId: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  QrScanStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>QrScanStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ READY: QrScanStatus<BR/>+ SCANNING: QrScanStatus<BR/>+ INVALID: QrScanStatus<BR/>+ PERMISSION_DENIED: QrScanStatus<BR/>+ FAILED: QrScanStatus<BR/>+ CANCELLED: QrScanStatus<BR/>+ FOUND: QrScanStatus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  QrCaptureActivity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» Activity</I><BR/><B>QrCaptureActivity</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ initializeContent(): DecoratedBarcodeView</TD></TR></TABLE>>];
  CaptureActivity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«library» ZXing</I><BR/><B>CaptureActivity</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ initializeContent(): DecoratedBarcodeView</TD></TR></TABLE>>];
  ThemeController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>ThemeController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- preferences: ThemePreferences<BR/>- mutableDarkTheme: MutableStateFlow&lt;Boolean&gt;<BR/>+ darkTheme: StateFlow&lt;Boolean&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ setDarkTheme(enabled: Boolean)</TD></TR></TABLE>>];
  ThemePreferences [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>ThemePreferences</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- preferences: SharedPreferences</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ isDarkTheme(): Boolean<BR/>+ setDarkTheme(enabled: Boolean)</TD></TR></TABLE>>];
  PhotoDecoder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» PhotoDecoder.kt</I><BR/><B>PhotoDecoder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ decodePhoto(photo: Photo): Bitmap?</TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>Discovery screens</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ HomeScreen(state, onSearch, onFilter, onRetry, onScanQr, onCampsiteClick)<BR/>+ CampsiteDetailsScreen(...)<BR/>+ QrScanScreen(state, onScanStarted, onScanResult, onCameraFailed, onRetry, onBack)<BR/>+ ThemeToggle(darkTheme, onThemeChange)</TD></TR></TABLE>>];
  FirebaseRepository -> CampsiteRepository [arrowhead=onormal];
  FirebaseRepository -> CampsiteDetailsRepository [arrowhead=onormal];
  QrCaptureActivity -> CaptureActivity [arrowhead=onormal];
  CampsiteRepository -> Campsite [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  CampsiteDetailsRepository -> Campsite [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..1"];
  CampsiteDetailsRepository -> Photo [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  Campsite -> Photo [arrowhead=none label="cover" taillabel="1" headlabel="0..1"];
  CampsiteListController -> CampsiteRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  CampsiteListController -> CampsiteListState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  CampsiteListState -> Campsite [dir=back arrowtail=odiamond label="campsites" taillabel="1" headlabel="0..*"];
  CampsiteListState -> CampsiteFilter [arrowhead=vee label="filter" taillabel="0..*" headlabel="1"];
  CampsiteDetailsController -> CampsiteDetailsRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  CampsiteDetailsController -> CampsiteDetailsState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  CampsiteDetailsState -> Campsite [dir=back arrowtail=odiamond label="campsite" taillabel="1" headlabel="0..1"];
  CampsiteDetailsState -> Photo [dir=back arrowtail=odiamond label="photos" taillabel="1" headlabel="0..*"];
  QrScanController -> QrScanState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  QrScanState -> QrScanStatus [arrowhead=vee label="status" taillabel="0..*" headlabel="1"];
  QrScanController -> CampsiteQr [arrowhead=vee label="decodes with" taillabel="0..*" headlabel="1"];
  ThemeController -> ThemePreferences [arrowhead=vee label="uses" taillabel="1" headlabel="1"];
  Views -> CampsiteListState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> CampsiteDetailsState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> QrScanState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> QrCaptureActivity [arrowhead=vee label="launches" taillabel="1" headlabel="0..1"];
  Views -> PhotoDecoder [arrowhead=vee label="calls" taillabel="0..*" headlabel="1"];
}

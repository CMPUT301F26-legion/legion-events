// UML class diagram: owner lottery setup (Person 4)
// Render with: python3 render.py lottery_setup.dot lottery_setup.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Lottery setup and management" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  Lottery [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Lottery</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ campsiteIds: List&lt;String&gt;<BR/>+ registrationStartAt: Timestamp<BR/>+ registrationEndAt: Timestamp<BR/>+ bookingStartAt: Timestamp<BR/>+ bookingEndAt: Timestamp<BR/>+ winnerCount: Int<BR/>+ waitlistLimit: Int<BR/>+ entrantCount: Int<BR/>+ status: String<BR/>+ winnersDrawn: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryBadge [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>LotteryBadge</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ OPEN: LotteryBadge<BR/>+ UPCOMING: LotteryBadge<BR/>+ CLOSED: LotteryBadge<BR/>+ DRAWN: LotteryBadge<BR/>+ NONE: LotteryBadge<BR/>+ label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">~ lotteryBadge(campsiteId, lotteries, now): LotteryBadge<BR/>~ lotteryBadge(lottery, now): LotteryBadge</TD></TR></TABLE>>];
  Campsite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Campsite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ name: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  WaitlistEntrant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>WaitlistEntrant</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ userId: String<BR/>+ status: String<BR/>+ joinedAt: Timestamp?<BR/>+ lotteryId: String<BR/>+ STATUS_JOINED: String<BR/>+ STATUS_WITHDRAWN: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>LotteryRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ createLottery(lottery: Lottery): String<BR/>+ updateLottery(lottery: Lottery)<BR/>+ getLottery(id: String): Lottery<BR/>+ getMyLotteries(): List&lt;Lottery&gt;<BR/>+ getWaitlist(lotteryId: String): List&lt;WaitlistEntrant&gt;</TD></TR></TABLE>>];
  FirebaseLotteryRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseLotteryRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore<BR/>- lotteries: CollectionReference</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ createLottery(lottery: Lottery): String<BR/>+ updateLottery(lottery: Lottery)<BR/>+ getLottery(id: String): Lottery<BR/>+ getMyLotteries(): List&lt;Lottery&gt;<BR/>+ getWaitlist(lotteryId: String): List&lt;WaitlistEntrant&gt;<BR/>- Lottery.editableFields(): Map&lt;String, Any&gt;</TD></TR></TABLE>>];
  LotteryEditController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>LotteryEditController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- lotteryId: String?<BR/>- repository: LotteryRepository<BR/>- loadCampsites: suspend () -&gt; List&lt;Campsite&gt;<BR/>- zone: TimeZone<BR/>- now: () -&gt; Date<BR/>- mutableState: MutableStateFlow&lt;LotteryEditState&gt;<BR/>+ state: StateFlow&lt;LotteryEditState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()<BR/>+ toggleCampsite(id: String)<BR/>+ setRegistrationStart(day), setRegistrationEnd(day)<BR/>+ setBookingStart(day), setBookingEnd(day)<BR/>+ setWinnerCount(value), setWaitlistLimit(value)<BR/>+ save()<BR/>- edit(field: LotteryField, change)<BR/>~ lockReason(lottery, now): String?<BR/>~ validateLottery(state, now, zone): Map</TD></TR></TABLE>>];
  LotteryEditState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>LotteryEditState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean, loadError: String?<BR/>+ editing: Boolean, locked: Boolean<BR/>+ campsites: List&lt;Campsite&gt;<BR/>+ selectedCampsiteIds: Set&lt;String&gt;<BR/>+ registrationStart, registrationEnd: String<BR/>+ bookingStart, bookingEnd: String<BR/>+ winnerCount, waitlistLimit: String<BR/>+ errors: Map&lt;LotteryField, String&gt;<BR/>+ saving: Boolean, message: String?<BR/>+ savedLotteryId: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryField [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>LotteryField</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ CAMPSITES: LotteryField<BR/>+ REGISTRATION: LotteryField<BR/>+ BOOKING: LotteryField<BR/>+ WINNERS: LotteryField<BR/>+ LIMIT: LotteryField</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerLotteriesController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>OwnerLotteriesController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- repository: LotteryRepository<BR/>- loadCampsites: suspend () -&gt; List&lt;Campsite&gt;<BR/>- now: () -&gt; Date<BR/>- mutableState: MutableStateFlow&lt;OwnerLotteriesState&gt;<BR/>+ state: StateFlow&lt;OwnerLotteriesState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>~ lotteryTitle(lottery, campsiteNames): String</TD></TR></TABLE>>];
  OwnerLotteriesState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerLotteriesState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ items: List&lt;OwnerLotteryItem&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerLotteryItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerLotteryItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ lottery: Lottery<BR/>+ title: String<BR/>+ badge: LotteryBadge</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryManagementController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>LotteryManagementController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- lotteryId: String<BR/>- repository: LotteryRepository<BR/>- loadCampsites: suspend () -&gt; List&lt;Campsite&gt;<BR/>- now: () -&gt; Date<BR/>- mutableState: MutableStateFlow&lt;LotteryManagementState&gt;<BR/>+ state: StateFlow&lt;LotteryManagementState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ selectTab(tab: ManagementTab)<BR/>~ waitlistRows(entries): List&lt;WaitlistRow&gt;</TD></TR></TABLE>>];
  LotteryManagementState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>LotteryManagementState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean, error: String?<BR/>+ lottery: Lottery?<BR/>+ title: String<BR/>+ badge: LotteryBadge?<BR/>+ editBlockedReason: String?<BR/>+ waitlist: List&lt;WaitlistRow&gt;<BR/>+ waitlistError: String?<BR/>+ tab: ManagementTab</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  WaitlistRow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>WaitlistRow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ position: Int<BR/>+ label: String<BR/>+ joinedAt: Timestamp?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  ManagementTab [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>ManagementTab</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ WAITLIST: ManagementTab<BR/>+ WINNERS: ManagementTab</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>Lottery screens</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ OwnerLotteriesScreen(...)<BR/>+ LotteryEditScreen(...)<BR/>+ LotteryManagementScreen(...)</TD></TR></TABLE>>];
  FirebaseLotteryRepository -> LotteryRepository [arrowhead=onormal];
  LotteryRepository -> Lottery [arrowhead=vee label="creates / returns" taillabel="0..*" headlabel="0..*"];
  LotteryRepository -> WaitlistEntrant [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  Lottery -> Campsite [arrowhead=none label="includes" taillabel="0..*" headlabel="1..8"];
  Lottery -> WaitlistEntrant [arrowhead=none label="waitlist" taillabel="1" headlabel="0..100"];
  LotteryEditController -> LotteryRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  LotteryEditController -> LotteryEditState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  LotteryEditState -> LotteryField [arrowhead=vee label="errors" taillabel="0..*" headlabel="0..*"];
  OwnerLotteriesController -> LotteryRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  OwnerLotteriesController -> OwnerLotteriesState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  OwnerLotteriesState -> OwnerLotteryItem [dir=back arrowtail=diamond label="items" taillabel="1" headlabel="0..*"];
  OwnerLotteryItem -> Lottery [dir=back arrowtail=odiamond label="lottery" taillabel="0..*" headlabel="1"];
  OwnerLotteryItem -> LotteryBadge [arrowhead=vee label="badge" taillabel="0..*" headlabel="1"];
  LotteryManagementController -> LotteryRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  LotteryManagementController -> LotteryManagementState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  LotteryManagementState -> Lottery [dir=back arrowtail=odiamond label="lottery" taillabel="1" headlabel="0..1"];
  LotteryManagementState -> WaitlistRow [dir=back arrowtail=diamond label="waitlist" taillabel="1" headlabel="0..*"];
  LotteryManagementState -> ManagementTab [arrowhead=vee label="tab" taillabel="0..*" headlabel="1"];
  Views -> LotteryEditState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> OwnerLotteriesState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> LotteryManagementState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
}

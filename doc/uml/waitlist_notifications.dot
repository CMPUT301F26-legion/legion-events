// UML class diagram: waitlist and notifications (Person 5, inbox from Person 6)
// Render with: python3 render.py waitlist_notifications.dot waitlist_notifications.png  (needs Graphviz and Google Chrome)
digraph G {
  graph [rankdir=BT fontname="Liberation Sans" nodesep=0.5 ranksep=0.7 dpi=110 pad=0.3
         label="Waitlist and notifications" labelloc=t fontsize=18];
  node  [shape=plain fontname="Liberation Sans" fontsize=10];
  edge  [fontname="Liberation Sans" fontsize=9 labeldistance=1.8 labelangle=35];
  // Notation: extends (hollow triangle), one-way navigability (open arrow), association (plain line),
  // aggregation (hollow diamond on the owner), composition (filled diamond on the owner).
  // taillabel = source multiplicity, headlabel = target multiplicity. Extends has none.

  Lottery [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>Lottery</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ registrationStartAt: Timestamp<BR/>+ registrationEndAt: Timestamp<BR/>+ waitlistLimit: Int<BR/>+ entrantCount: Int<BR/>+ status: String<BR/>+ winnersDrawn: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  WaitlistEntrant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>WaitlistEntrant</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ userId: String<BR/>+ status: String<BR/>+ joinedAt: Timestamp?<BR/>+ lotteryId: String<BR/>+ STATUS_JOINED: String<BR/>+ STATUS_WITHDRAWN: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerNotice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>OwnerNotice</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ ownerId: String<BR/>+ lotteryId: String<BR/>+ message: String<BR/>+ recipientIds: List&lt;String&gt;<BR/>+ createdAt: Timestamp?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryNotification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8f0e8"><I>«model»</I><BR/><B>LotteryNotification</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ result: LotteryResult<BR/>+ offerId: String?<BR/>+ createdAt: Timestamp</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  LotteryResult [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«enumeration»</I><BR/><B>LotteryResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ WON: LotteryResult<BR/>+ LOST: LotteryResult<BR/>+ storedType: String<BR/>+ title: Int<BR/>+ message: Int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ fromStoredType(type: String?): LotteryResult?</TD></TR></TABLE>>];
  WaitlistRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>WaitlistRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getLotteriesForCampsite(campsiteId: String): List&lt;LotteryEntry&gt;<BR/>+ getMyEntries(): List&lt;LotteryEntry&gt;<BR/>+ join(lotteryId: String)<BR/>+ leave(lotteryId: String)</TD></TR></TABLE>>];
  LotteryEntry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>LotteryEntry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ lottery: Lottery<BR/>+ status: String?<BR/>+ campsiteNames: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  WaitlistRepositoryKt [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«utility» WaitlistRepository.kt</I><BR/><B>WaitlistRepositoryKt</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ Lottery.isRegistrationOpen(now: Timestamp): Boolean</TD></TR></TABLE>>];
  FirebaseWaitlistRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseWaitlistRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore<BR/>- now: () -&gt; Timestamp</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getLotteriesForCampsite(campsiteId: String): List&lt;LotteryEntry&gt;<BR/>+ getMyEntries(): List&lt;LotteryEntry&gt;<BR/>+ join(lotteryId: String)<BR/>+ leave(lotteryId: String)<BR/>- myEntries(): List&lt;WaitlistEntrant&gt;<BR/>- campsiteNames(ids: List&lt;String&gt;): List&lt;String&gt;<BR/>- userId(): String</TD></TR></TABLE>>];
  OwnerNoticeRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>OwnerNoticeRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ sendNotification(lotteryId: String, message: String): Int<BR/>+ getSentNotices(): List&lt;OwnerNotice&gt;<BR/>+ observeReceived(userId: String): Flow&lt;List&lt;OwnerNotice&gt;&gt;</TD></TR></TABLE>>];
  FirebaseOwnerNoticeRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseOwnerNoticeRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore<BR/>- lotteries: LotteryRepository<BR/>- COLLECTION = "ownerNotices"</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ sendNotification(lotteryId: String, message: String): Int<BR/>+ getSentNotices(): List&lt;OwnerNotice&gt;<BR/>+ observeReceived(userId: String): Flow&lt;List&lt;OwnerNotice&gt;&gt;<BR/>- userId(): String</TD></TR></TABLE>>];
  LotteryRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>LotteryRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ getMyLotteries(): List&lt;Lottery&gt;<BR/>+ getWaitlist(lotteryId: String): List&lt;WaitlistEntrant&gt;</TD></TR></TABLE>>];
  NotificationRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface»</I><BR/><B>NotificationRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ observe(userId: String): Flow&lt;List&lt;LotteryNotification&gt;&gt;</TD></TR></TABLE>>];
  FirebaseNotificationRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>FirebaseNotificationRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- auth: FirebaseAuth<BR/>- firestore: FirebaseFirestore</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ observe(userId: String): Flow&lt;List&lt;LotteryNotification&gt;&gt;</TD></TR></TABLE>>];
  LotteryMessagingService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>LotteryMessagingService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ onNewToken(token: String)<BR/>+ onMessageReceived(message: RemoteMessage)</TD></TR></TABLE>>];
  FirebaseMessagingService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«library»</I><BR/><B>FirebaseMessagingService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  CampsiteLotteryController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>CampsiteLotteryController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- campsiteId: String<BR/>- repository: WaitlistRepository<BR/>- now: () -&gt; Timestamp<BR/>- mutableState: MutableStateFlow&lt;CampsiteLotteryState&gt;<BR/>+ state: StateFlow&lt;CampsiteLotteryState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()<BR/>+ join(lotteryId: String)</TD></TR></TABLE>>];
  CampsiteLotteryState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>CampsiteLotteryState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ lotteries: List&lt;LotteryEntry&gt;<BR/>+ error: String?<BR/>+ joining: String?<BR/>+ joinedLotteryId: String?<BR/>+ actionError: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  MyLotteriesController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>MyLotteriesController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- repository: WaitlistRepository<BR/>- now: () -&gt; Timestamp<BR/>- mutableState: MutableStateFlow&lt;MyLotteriesState&gt;<BR/>+ state: StateFlow&lt;MyLotteriesState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()<BR/>+ canLeave(entry: LotteryEntry): Boolean<BR/>+ requestLeave(lotteryId: String)<BR/>+ cancelLeave()<BR/>+ confirmLeave()</TD></TR></TABLE>>];
  MyLotteriesState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>MyLotteriesState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ entries: List&lt;LotteryEntry&gt;<BR/>+ error: String?<BR/>+ confirmingLeave: String?<BR/>+ leaving: Boolean<BR/>+ actionError: String?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  OwnerNoticesController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>OwnerNoticesController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- lotteries: LotteryRepository<BR/>- loadCampsites: suspend () -&gt; List&lt;Campsite&gt;<BR/>- notices: OwnerNoticeRepository<BR/>- mutableState: MutableStateFlow&lt;OwnerNoticesState&gt;<BR/>+ state: StateFlow&lt;OwnerNoticesState&gt;<BR/>- request: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ refresh()<BR/>+ selectLottery(lotteryId: String)<BR/>+ setMessage(message: String)<BR/>+ send()</TD></TR></TABLE>>];
  OwnerNoticesState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>OwnerNoticesState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ loading: Boolean<BR/>+ error: String?<BR/>+ targets: List&lt;NoticeTarget&gt;<BR/>+ selectedLotteryId: String?<BR/>+ message: String<BR/>+ messageError: String?<BR/>+ sending: Boolean<BR/>+ result: String?<BR/>+ sent: List&lt;Pair&lt;OwnerNotice, String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  NoticeTarget [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>NoticeTarget</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ id: String<BR/>+ label: String<BR/>+ entrantCount: Int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  InboxController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e8eef8"><I>«controller» ViewModel</I><BR/><B>InboxController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">- userId: String<BR/>- repository: NotificationRepository<BR/>- notices: OwnerNoticeRepository?<BR/>- mutableState: MutableStateFlow&lt;InboxState&gt;<BR/>+ state: StateFlow&lt;InboxState&gt;<BR/>- subscription: Job?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ retry()</TD></TR></TABLE>>];
  InboxState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><I>«interface» sealed</I><BR/><B>InboxState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Loading [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«object»</I><BR/><B>InboxState.Loading</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Failed [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«object»</I><BR/><B>InboxState.Failed</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Loaded [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD><I>«data»</I><BR/><B>InboxState.Loaded</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ notifications: List&lt;LotteryNotification&gt;<BR/>+ notices: List&lt;OwnerNotice&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR></TABLE>>];
  Views [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f8f0e0"><I>«view» composables</I><BR/><B>Waitlist and notice screens</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T" BORDER="1">+ CampsiteLotterySection(state, onJoin, onRetry, onMyLotteries)<BR/>+ LotteriesScreen(entries, canLeave, onLeave, onCancelLeave, onConfirmLeave, onRetry, onOffers)<BR/>+ OwnerNoticesScreen(state, onSelectLottery, onMessage, onSend, onRetry)<BR/>+ InboxScreen(state, onRetry, onOffer, onEnablePush)</TD></TR></TABLE>>];
  FirebaseWaitlistRepository -> WaitlistRepository [arrowhead=onormal];
  FirebaseOwnerNoticeRepository -> OwnerNoticeRepository [arrowhead=onormal];
  FirebaseNotificationRepository -> NotificationRepository [arrowhead=onormal];
  LotteryMessagingService -> FirebaseMessagingService [arrowhead=onormal];
  Loading -> InboxState [arrowhead=onormal];
  Loaded -> InboxState [arrowhead=onormal];
  Failed -> InboxState [arrowhead=onormal];
  WaitlistRepository -> LotteryEntry [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  LotteryEntry -> Lottery [dir=back arrowtail=odiamond label="lottery" taillabel="0..*" headlabel="1"];
  FirebaseWaitlistRepository -> WaitlistEntrant [arrowhead=vee label="joins / leaves" taillabel="1" headlabel="0..*"];
  WaitlistRepositoryKt -> Lottery [arrowhead=vee label="checks registration" taillabel="0..*" headlabel="0..*"];
  Lottery -> WaitlistEntrant [arrowhead=none label="waitlist" taillabel="1" headlabel="0..100"];
  FirebaseOwnerNoticeRepository -> LotteryRepository [arrowhead=vee label="reads waitlist" taillabel="0..*" headlabel="1"];
  LotteryRepository -> WaitlistEntrant [arrowhead=vee label="returns" taillabel="0..*" headlabel="0..*"];
  OwnerNoticeRepository -> OwnerNotice [arrowhead=vee label="sends / returns" taillabel="0..*" headlabel="0..*"];
  OwnerNotice -> Lottery [arrowhead=none label="sent to waitlist of" taillabel="0..*" headlabel="1"];
  NotificationRepository -> LotteryNotification [arrowhead=vee label="observes" taillabel="0..*" headlabel="0..*"];
  LotteryNotification -> LotteryResult [arrowhead=vee label="result" taillabel="0..*" headlabel="1"];
  LotteryMessagingService -> LotteryResult [arrowhead=vee label="reads" taillabel="0..*" headlabel="1"];
  CampsiteLotteryController -> WaitlistRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  CampsiteLotteryController -> CampsiteLotteryState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  CampsiteLotteryState -> LotteryEntry [dir=back arrowtail=odiamond label="lotteries" taillabel="1" headlabel="0..*"];
  MyLotteriesController -> WaitlistRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  MyLotteriesController -> MyLotteriesState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  MyLotteriesState -> LotteryEntry [dir=back arrowtail=odiamond label="entries" taillabel="1" headlabel="0..*"];
  OwnerNoticesController -> LotteryRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  OwnerNoticesController -> OwnerNoticeRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  OwnerNoticesController -> OwnerNoticesState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  OwnerNoticesState -> NoticeTarget [dir=back arrowtail=odiamond label="targets" taillabel="1" headlabel="0..*"];
  OwnerNoticesState -> OwnerNotice [dir=back arrowtail=odiamond label="sent" taillabel="1" headlabel="0..*"];
  InboxController -> NotificationRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="1"];
  InboxController -> OwnerNoticeRepository [arrowhead=vee label="uses" taillabel="0..*" headlabel="0..1"];
  InboxController -> InboxState [dir=back arrowtail=diamond label="exposes" taillabel="1" headlabel="1"];
  Loaded -> LotteryNotification [dir=back arrowtail=odiamond label="notifications" taillabel="1" headlabel="0..*"];
  Loaded -> OwnerNotice [dir=back arrowtail=odiamond label="notices" taillabel="1" headlabel="0..*"];
  Views -> CampsiteLotteryState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> MyLotteriesState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> OwnerNoticesState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
  Views -> InboxState [arrowhead=vee label="renders" taillabel="0..*" headlabel="1"];
}

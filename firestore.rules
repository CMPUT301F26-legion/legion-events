rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && me().disabled == false; }
    function admin() { return activeUser() && me().role == 'admin'; }
    function mine(uid) { return activeUser() && request.auth.uid == uid; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function text(value, max) { return value is string && value.size() <= max; }
    function updatedNow() { return request.resource.data.updatedAt == request.time; }
    function campsite(id) { return get(/databases/$(database)/documents/campsites/$(id)).data; }
    function lottery(id) { return get(/databases/$(database)/documents/lotteries/$(id)).data; }
    function offer(id) { return get(/databases/$(database)/documents/offers/$(id)).data; }
    function acceptedRequest(id, offerId, lotteryId, uid) {
      let path = /databases/$(database)/documents/reservations/$(id);
      let d = getAfter(path).data;
      return id is string && id.size() > 0 && !exists(path)
        && d.offerId == offerId && d.lotteryId == lotteryId && d.userId == uid
        && d.status == 'requested' && d.createdAt == request.time;
    }
    function claimedOffer(offerId, reservationId) {
      let d = getAfter(/databases/$(database)/documents/offers/$(offerId)).data;
      return d.status == 'pending' && d.response == 'accept' && d.reservationId == reservationId
        && d.respondedAt == request.time && d.updatedAt == request.time;
    }
    // Foreground booking mode trusts an owner to process their own campsite, just as local draws do.
    // The app reads/writes every night atomically. Rules check each lock and linked state transition;
    // rules cannot enumerate a variable 366-night write set or prove random replacement selection.
    function bookingBefore(id) { return get(/databases/$(database)/documents/reservations/$(id)).data; }
    function bookingAfter(id) { return getAfter(/databases/$(database)/documents/reservations/$(id)).data; }
    function bookingConfirmed(id) {
      let before = bookingBefore(id);
      let after = bookingAfter(id);
      let o = offer(before.offerId);
      let oa = getAfter(/databases/$(database)/documents/offers/$(before.offerId)).data;
      return mine(before.ownerId) && before.status == 'requested' && after.status == 'confirmed'
        && after.updatedAt == request.time && o.status == 'pending' && o.response == 'accept'
        && o.reservationId == id && o.userId == before.userId && o.lotteryId == before.lotteryId
        && oa.status == 'used' && oa.reservationId == id && oa.updatedAt == request.time;
    }
    function eligibleBooking(d) {
      let l = lottery(d.lotteryId);
      let c = campsite(d.campsiteId);
      let o = offer(d.offerId);
      return l.ownerId == d.ownerId && l.winnersDrawn == true && c.ownerId == d.ownerId && c.active == true
        && get(/databases/$(database)/documents/users/$(d.userId)).data.disabled == false
        && d.offerId == d.lotteryId + '_' + d.userId && d.campsiteId in l.campsiteIds && d.campsiteId in o.campsiteIds
        && o.expiresAt == l.bookingEndAt && o.respondedAt == d.createdAt
        && d.createdAt >= l.bookingStartAt && d.createdAt < l.bookingEndAt && d.createdAt < o.expiresAt
        && d.rulesAccepted == true && d.cancellationRequested == false
        && d.startDate == d.startDate.date() && d.endDate == d.endDate.date()
        && d.startDate >= d.createdAt.date() && d.endDate > d.startDate
        && d.endDate - d.startDate <= duration.value(366, 'd')
        && d.guestCount is int && d.guestCount >= 1 && d.guestCount <= c.maxGuests
        && d.totalPrice == c.pricePerNight * ((d.endDate.toMillis() - d.startDate.toMillis()) / 86400000);
    }
    function bookingReleased(id) {
      let b = bookingBefore(id);
      let a = bookingAfter(id);
      return mine(b.ownerId) && ((b.status == 'confirmed' && b.cancellationRequested == true
          && a.status == 'cancelled' && a.cancellationRequested == false && a.updatedAt == request.time)
        || (b.status == 'rejected' && a.status == 'rejected'
          && getAfter(/databases/$(database)/documents/reservationReleases/$(id)).data.processedAt == request.time));
    }
    function bookingNotice(d, id) {
      let b = bookingBefore(d.reservationId);
      let confirmed = d.type == 'reservation_confirmed';
      return d.keys().hasAll(['toUserId','fromUserId','lotteryId','reservationId','type','title','body','read','createdAt','updatedAt'])
        && d.keys().hasOnly(['toUserId','fromUserId','lotteryId','reservationId','type','title','body','read','createdAt','updatedAt'])
        && d.type in ['reservation_confirmed','reservation_cancelled']
        && id == d.type + '_' + d.reservationId && d.toUserId == b.userId && d.lotteryId == b.lotteryId
        && d.fromUserId == null && d.read == false && d.createdAt == request.time && d.updatedAt == request.time
        && d.title == (confirmed ? 'Reservation confirmed' : 'Reservation cancelled')
        && d.body == (confirmed ? 'Your campsite reservation is confirmed. View your booking details.'
          : 'Your reservation has been cancelled and its dates released.')
        && (confirmed ? bookingConfirmed(d.reservationId) : (bookingReleased(d.reservationId) && bookingAfter(d.reservationId).status == 'cancelled'));
    }
    function replacement(id) { return getAfter(/databases/$(database)/documents/offerReplacements/$(id)).data; }
    function replacementCommitted(id) {
      let o = offer(id);
      let l = lottery(o.lotteryId);
      let m = replacement(id);
      return mine(l.ownerId) && l.winnersDrawn == true && o.status == 'pending' && o.response == 'decline'
        && o.get('reservationId', null) == null && o.expiresAt == l.bookingEndAt && o.campsiteIds == l.campsiteIds
        && !exists(/databases/$(database)/documents/offerReplacements/$(id))
        && m.declinedOfferId == id && m.lotteryId == o.lotteryId && m.processedAt == request.time;
    }
    function replacementWinner(id, uid, lotteryId) {
      let m = replacement(id);
      let entry = get(/databases/$(database)/documents/waitlist/$(lotteryId + '_' + uid)).data;
      let after = getAfter(/databases/$(database)/documents/waitlist/$(lotteryId + '_' + uid)).data;
      return replacementCommitted(id) && m.replacementUserId == uid && m.lotteryId == lotteryId
        && m.replacementOfferId == lotteryId + '_' + uid && request.time < offer(id).expiresAt
        && entry.userId == uid && entry.lotteryId == lotteryId && entry.status == 'lost'
        && after.status == 'won' && after.updatedAt == request.time
        && !exists(/databases/$(database)/documents/offers/$(lotteryId + '_' + uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.disabled == false;
    }
    function replacementResult(d, id) {
      let declined = getAfter(/databases/$(database)/documents/offers/$(d.offerId)).data.replacementFor;
      return id == 'lottery_replacement_' + declined && d.type == 'lottery_won'
        && d.offerId == d.lotteryId + '_' + d.toUserId && d.createdAt == request.time
        && replacementWinner(declined, d.toUserId, d.lotteryId);
    }
    function chat(id) { return get(/databases/$(database)/documents/conversations/$(id)).data; }
    // Separate comparisons let either UID-scoped conversation query prove membership.
    function participant(c) {
      return activeUser() && (request.auth.uid == c.entrantId || request.auth.uid == c.ownerId);
    }
    function openLottery(l) {
      return l.status == 'open' && l.winnersDrawn == false
        && request.time >= l.registrationStartAt && request.time < l.registrationEndAt;
    }
    function validProfile(d) {
      return text(d.name, 120) && text(d.email, 254) && text(d.phone, 40)
        && (d.photoId == null || text(d.photoId, 150))
        && d.notificationsEnabled is bool && (d.fcmToken == null || text(d.fcmToken, 4096));
    }
    match /users/{uid} {
      allow read: if mine(uid) || admin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name','email','phone','role','photoId','notificationsEnabled','fcmToken','disabled','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['name','email','phone','role','photoId','notificationsEnabled','fcmToken','disabled','createdAt','updatedAt'])
        && validProfile(request.resource.data) && request.resource.data.role == 'user'
        && request.resource.data.disabled == false && request.resource.data.createdAt == request.time && updatedNow();
      allow update: if (mine(uid) && changedOnly(['name','email','phone','photoId','notificationsEnabled','fcmToken','updatedAt'])
          && validProfile(request.resource.data) && updatedNow())
        || (admin() && changedOnly(['disabled','moderationReason','updatedAt'])
          && request.resource.data.disabled is bool && text(request.resource.data.get('moderationReason', ''), 1000) && updatedNow());
      // Roles can only be assigned through privileged project administration.
      allow delete: if mine(uid);
    }
    function validCampsite(d) {
      return text(d.name, 150) && d.name.size() > 0 && text(d.description, 10000)
        && text(d.locationName, 250) && d.location is latlng
        && d.maxGuests is int && d.maxGuests >= 1 && d.maxGuests <= 100
        && d.pricePerNight is int && d.pricePerNight >= 0 && d.pricePerNight <= 10000000
        && d.amenities is list && d.amenities.size() <= 50 && d.tags is list && d.tags.size() <= 50
        && text(d.rules, 10000) && text(d.cancellationPolicy, 5000)
        && d.availableNights is list && d.availableNights.size() <= 366
        && (d.photoId == null || text(d.photoId, 150)) && d.active is bool;
    }
    match /campsites/{id} {
      allow read: if activeUser() && (resource.data.active || resource.data.ownerId == request.auth.uid || admin());
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId','name','description','locationName','location','maxGuests','pricePerNight','amenities','tags','rules','cancellationPolicy','availableNights','photoId','ratingAverage','ratingCount','active','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerId','name','description','locationName','location','maxGuests','pricePerNight','amenities','tags','rules','cancellationPolicy','availableNights','photoId','ratingAverage','ratingCount','active','createdAt','updatedAt'])
        && validCampsite(request.resource.data) && request.resource.data.ratingAverage == 0 && request.resource.data.ratingCount == 0
        && request.resource.data.createdAt == request.time && updatedNow();
      allow update: if (mine(resource.data.ownerId)
          && changedOnly(['name','description','locationName','location','maxGuests','pricePerNight','amenities','tags','rules','cancellationPolicy','availableNights','photoId','active','updatedAt'])
          && validCampsite(request.resource.data) && updatedNow())
        || (admin() && changedOnly(['active','moderationReason','updatedAt'])
          && request.resource.data.active is bool && text(request.resource.data.get('moderationReason', ''), 1000) && updatedNow());
      allow delete: if false;
    }
    function validLottery(d) {
      return d.campsiteIds is list && d.campsiteIds.size() >= 1 && d.campsiteIds.size() <= 8
        && d.registrationStartAt is timestamp && d.registrationEndAt is timestamp
        && d.bookingStartAt is timestamp && d.bookingEndAt is timestamp
        && d.registrationStartAt < d.registrationEndAt && d.registrationEndAt <= d.bookingStartAt
        && d.bookingStartAt < d.bookingEndAt
        && d.waitlistLimit is int && d.waitlistLimit >= 1 && d.waitlistLimit <= 100
        && d.winnerCount is int && d.winnerCount >= 1 && d.winnerCount <= d.waitlistLimit;
    }
    // A small bounded list permits rules to verify every listed campsite owner.
    function ownSite(ids, n) { return ids.size() <= n || (ids[n] is string && campsite(ids[n]).ownerId == request.auth.uid && campsite(ids[n]).active); }
    function ownSites(ids) {
      return ownSite(ids,0) && ownSite(ids,1) && ownSite(ids,2) && ownSite(ids,3) && ownSite(ids,4)
        && ownSite(ids,5) && ownSite(ids,6) && ownSite(ids,7);
    }
    function entrantCounterChange(id) {
      let path = /databases/$(database)/documents/waitlist/$(id + '_' + request.auth.uid);
      let after = getAfter(path).data;
      let joined = after.status == 'joined' && (!exists(path) || get(path).data.status == 'withdrawn');
      let withdrawn = after.status == 'withdrawn' && exists(path) && get(path).data.status == 'joined';
      return activeUser() && openLottery(resource.data) && changedOnly(['entrantCount','updatedAt']) && updatedNow()
        && after.userId == request.auth.uid && after.lotteryId == id
        && ((joined && request.resource.data.entrantCount == resource.data.entrantCount + 1
              && request.resource.data.entrantCount <= resource.data.waitlistLimit)
          || (withdrawn && request.resource.data.entrantCount == resource.data.entrantCount - 1
              && request.resource.data.entrantCount >= 0));
    }

    // Closing registration is a deadline-only transition, including for older test lotteries
    // whose booking dates were edited in the console. All other fields remain unchanged.
    function endRegistrationUpdate() {
      return mine(resource.data.ownerId) && resource.data.status == 'open'
        && resource.data.winnersDrawn == false
        && resource.data.registrationStartAt < request.time
        && request.time < resource.data.registrationEndAt
        && changedOnly(['registrationEndAt','updatedAt'])
        && request.resource.data.registrationEndAt == request.time && updatedNow();
    }

    // LOCAL DRAW additions. The owner is trusted to select the entrants and winners.
    // The immutable manifest bounds that authority to one closed lottery and shares rule reads
    // across up to 100 entrants, avoiding the atomic-write document-access limit.
    function drawRecord(id) { return getAfter(/databases/$(database)/documents/lotteryDraws/$(id)).data; }
    function localDrawCommitted(id) {
      let before = lottery(id);
      let after = getAfter(/databases/$(database)/documents/lotteries/$(id)).data;
      let draw = drawRecord(id);
      return mine(before.ownerId) && before.status == 'open' && before.winnersDrawn == false
        && request.time >= before.registrationEndAt && after.winnersDrawn == true
        && after.updatedAt == request.time && draw.createdAt == request.time
        && draw.ownerId == before.ownerId && draw.lotteryId == id;
    }
    function validDraw(d, l, id) {
      return d.keys().hasAll(['lotteryId','ownerId','entrantIds','winnerIds','createdAt'])
        && d.keys().hasOnly(['lotteryId','ownerId','entrantIds','winnerIds','createdAt'])
        && d.lotteryId == id && d.ownerId == l.ownerId && d.createdAt == request.time
        && d.entrantIds is list && d.entrantIds.size() == l.entrantCount && d.entrantIds.size() <= 100
        && d.entrantIds.toSet().size() == d.entrantIds.size()
        && d.winnerIds is list && d.winnerIds.toSet().size() == d.winnerIds.size()
        && d.entrantIds.hasAll(d.winnerIds)
        && d.winnerIds.size() == (l.entrantCount < l.winnerCount ? l.entrantCount : l.winnerCount);
    }
    function localDrawUpdate(id) {
      return localDrawCommitted(id) && changedOnly(['winnersDrawn','updatedAt'])
        && validDraw(drawRecord(id), resource.data, id);
    }
    function localResult(d, id) {
      let draw = drawRecord(d.lotteryId);
      let won = d.toUserId in draw.winnerIds;
      return localDrawCommitted(d.lotteryId) && d.toUserId in draw.entrantIds
        && id == d.lotteryId + '_' + d.toUserId && d.createdAt == request.time
        && d.type == (won ? 'lottery_won' : 'lottery_lost')
        && d.offerId == (won ? id : null);
    }
    match /lotteryDraws/{id} {
      allow get: if mine(lottery(id).ownerId);
      allow create: if localDrawCommitted(id) && validDraw(request.resource.data, lottery(id), id);
      allow list, update, delete: if false;
    }
    match /lotteries/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId','campsiteIds','registrationStartAt','registrationEndAt','bookingStartAt','bookingEndAt','winnerCount','waitlistLimit','entrantCount','status','winnersDrawn','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerId','campsiteIds','registrationStartAt','registrationEndAt','bookingStartAt','bookingEndAt','winnerCount','waitlistLimit','entrantCount','status','winnersDrawn','createdAt','updatedAt'])
        && validLottery(request.resource.data) && ownSites(request.resource.data.campsiteIds)
        && request.resource.data.entrantCount == 0 && request.resource.data.winnersDrawn == false
        && request.resource.data.status == 'open' && request.resource.data.registrationEndAt > request.time
        && request.resource.data.createdAt == request.time && updatedNow();
      // US 02.04.06: the owner can edit until registration closes and the draw starts.
      // Once registration opens its first day is fixed; once entrants join the campsites are
      // fixed and the limit cannot drop below the number who joined.
      allow update: if (mine(resource.data.ownerId) && resource.data.winnersDrawn == false
          && request.time < resource.data.registrationEndAt
          && changedOnly(['campsiteIds','registrationStartAt','registrationEndAt','bookingStartAt','bookingEndAt','winnerCount','waitlistLimit','updatedAt'])
          && validLottery(request.resource.data) && ownSites(request.resource.data.campsiteIds)
          // Equal to request.time ends registration now (S16 "End registration now"); validLottery
          // still requires it to be after registration opened.
          && request.resource.data.registrationEndAt >= request.time
          && ((request.time < resource.data.registrationStartAt && request.resource.data.registrationStartAt > request.time)
            || request.resource.data.registrationStartAt == resource.data.registrationStartAt)
          && (resource.data.entrantCount == 0 || request.resource.data.campsiteIds == resource.data.campsiteIds)
          && request.resource.data.waitlistLimit >= resource.data.entrantCount
          && updatedNow())
        || endRegistrationUpdate() || entrantCounterChange(id) || localDrawUpdate(id);
      allow delete: if false;
      // Permission-only eligibility probes: these documents are never stored. An owner can
      // distinguish an active entrant from a disabled/deleted one without reading private profiles.
      match /bookingEligibility/{uid} {
        allow get: if mine(lottery(id).ownerId)
          && (uid == request.auth.uid || get(/databases/$(database)/documents/waitlist/$(id + '_' + uid)).data.userId == uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.disabled == false;
        allow list, write: if false;
      }
    }
    function counterAfter(id, delta) {
      let before = lottery(id);
      let after = getAfter(/databases/$(database)/documents/lotteries/$(id)).data;
      return openLottery(before) && after.entrantCount == before.entrantCount + delta
        && after.entrantCount >= 0 && after.entrantCount <= before.waitlistLimit;
    }
    match /waitlist/{id} {
      allow read: if mine(resource.data.userId) || mine(lottery(resource.data.lotteryId).ownerId) || admin();
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid
        && id == request.resource.data.lotteryId + '_' + request.auth.uid
        && request.resource.data.keys().hasAll(['lotteryId','userId','status','joinedAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['lotteryId','userId','status','joinedAt','updatedAt'])
        && request.resource.data.status == 'joined' && request.resource.data.joinedAt == request.time
        && updatedNow() && counterAfter(request.resource.data.lotteryId, 1);
      allow update: if (mine(resource.data.userId) && changedOnly(['status','joinedAt','updatedAt']) && updatedNow()
        && ((resource.data.status == 'joined' && request.resource.data.status == 'withdrawn'
              && request.resource.data.joinedAt == resource.data.joinedAt && counterAfter(resource.data.lotteryId, -1))
          || (resource.data.status == 'withdrawn' && request.resource.data.status == 'joined'
              && request.resource.data.joinedAt == request.time && counterAfter(resource.data.lotteryId, 1))))
        || (localDrawCommitted(resource.data.lotteryId) && resource.data.status == 'joined'
          && id == resource.data.lotteryId + '_' + resource.data.userId
          && changedOnly(['status','updatedAt']) && updatedNow()
          && resource.data.userId in drawRecord(resource.data.lotteryId).entrantIds
          && request.resource.data.status == (resource.data.userId in drawRecord(resource.data.lotteryId).winnerIds ? 'won' : 'lost'))
        || (resource.data.status == 'lost' && request.resource.data.status == 'won'
          && id == resource.data.lotteryId + '_' + resource.data.userId && changedOnly(['status','updatedAt']) && updatedNow()
          && replacementWinner(getAfter(/databases/$(database)/documents/offers/$(id)).data.replacementFor,
            resource.data.userId, resource.data.lotteryId));
      allow delete: if false;
    }
    match /offers/{id} {
      allow read: if mine(resource.data.userId) || mine(lottery(resource.data.lotteryId).ownerId) || admin();
      allow create: if (localDrawCommitted(request.resource.data.lotteryId)
        && request.resource.data.keys().hasAll(['lotteryId','userId','campsiteIds','status','response','expiresAt','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['lotteryId','userId','campsiteIds','status','response','expiresAt','createdAt','updatedAt'])
        && id == request.resource.data.lotteryId + '_' + request.resource.data.userId
        && request.resource.data.userId in drawRecord(request.resource.data.lotteryId).winnerIds
        && request.resource.data.campsiteIds == lottery(request.resource.data.lotteryId).campsiteIds
        && request.resource.data.expiresAt == lottery(request.resource.data.lotteryId).bookingEndAt
        && request.resource.data.status == 'pending' && request.resource.data.response == null
        && request.resource.data.createdAt == request.time && updatedNow())
        || (request.resource.data.keys().hasAll(['lotteryId','userId','campsiteIds','status','response','expiresAt','createdAt','updatedAt','replacementFor'])
          && request.resource.data.keys().hasOnly(['lotteryId','userId','campsiteIds','status','response','expiresAt','createdAt','updatedAt','replacementFor'])
          && id == request.resource.data.lotteryId + '_' + request.resource.data.userId
          && replacementWinner(request.resource.data.replacementFor, request.resource.data.userId, request.resource.data.lotteryId)
          && request.resource.data.campsiteIds == offer(request.resource.data.replacementFor).campsiteIds
          && request.resource.data.expiresAt == offer(request.resource.data.replacementFor).expiresAt
          && request.resource.data.status == 'pending' && request.resource.data.response == null
          && request.resource.data.createdAt == request.time && updatedNow());
      allow update: if (mine(resource.data.userId) && resource.data.status == 'pending'
        && request.time < resource.data.expiresAt && resource.data.get('response', null) == null
        && request.resource.data.respondedAt == request.time && updatedNow()
        && ((changedOnly(['response','respondedAt','updatedAt']) && request.resource.data.response == 'decline')
          || (changedOnly(['response','reservationId','respondedAt','updatedAt'])
            && request.resource.data.response == 'accept'
            && acceptedRequest(request.resource.data.reservationId, id, resource.data.lotteryId, request.auth.uid))))
        || (resource.data.status == 'pending' && resource.data.response == 'accept'
          && mine(lottery(resource.data.lotteryId).ownerId) && updatedNow()
          && ((changedOnly(['status','updatedAt']) && request.resource.data.status == 'used'
              && bookingConfirmed(resource.data.reservationId))
            || (changedOnly(['response','reservationId','respondedAt','updatedAt']) && request.resource.data.response == null
              && !request.resource.data.keys().hasAny(['reservationId','respondedAt'])
              && bookingAfter(resource.data.reservationId).status == 'rejected'
              && bookingAfter(resource.data.reservationId).ownerId == request.auth.uid
              && bookingAfter(resource.data.reservationId).userId == resource.data.userId
              && bookingAfter(resource.data.reservationId).lotteryId == resource.data.lotteryId)));
      allow delete: if false;
    }
    match /lotteryNotificationOutbox/{id} {
      allow create: if (localResult(request.resource.data, id) || replacementResult(request.resource.data, id))
        && request.resource.data.keys().hasAll(['type','toUserId','lotteryId','offerId','createdAt','deliveryStatus','updatedAt'])
        && request.resource.data.keys().hasOnly(['type','toUserId','lotteryId','offerId','createdAt','deliveryStatus','updatedAt'])
        && request.resource.data.deliveryStatus == 'pending' && updatedNow();
      allow read, update, delete: if false;
    }
    match /reservations/{id} {
      allow read: if mine(resource.data.userId) || mine(resource.data.ownerId) || admin();
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['lotteryId','offerId','campsiteId','userId','ownerId','startDate','endDate','guestCount','totalPrice','rulesAccepted','status','cancellationRequested','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['lotteryId','offerId','campsiteId','userId','ownerId','startDate','endDate','guestCount','totalPrice','rulesAccepted','status','cancellationRequested','createdAt','updatedAt'])
        && request.resource.data.status == 'requested' && request.resource.data.rulesAccepted == true
        && request.resource.data.cancellationRequested == false
        && request.resource.data.startDate is timestamp && request.resource.data.endDate is timestamp
        && request.resource.data.startDate < request.resource.data.endDate
        && request.resource.data.startDate == request.resource.data.startDate.date()
        && request.resource.data.endDate == request.resource.data.endDate.date()
        && request.resource.data.startDate >= request.time.date()
        && request.resource.data.endDate - request.resource.data.startDate <= duration.value(366, 'd')
        && request.resource.data.guestCount is int && request.resource.data.guestCount >= 1
        && request.resource.data.totalPrice is int && request.resource.data.totalPrice >= 0
        && request.resource.data.offerId == request.resource.data.lotteryId + '_' + request.auth.uid
        && offer(request.resource.data.offerId).userId == request.auth.uid
        && offer(request.resource.data.offerId).lotteryId == request.resource.data.lotteryId
        && offer(request.resource.data.offerId).status == 'pending'
        && offer(request.resource.data.offerId).get('response', null) == null
        && request.time < offer(request.resource.data.offerId).expiresAt
        && request.time >= lottery(request.resource.data.lotteryId).bookingStartAt
        && request.time < lottery(request.resource.data.lotteryId).bookingEndAt
        && request.resource.data.ownerId == lottery(request.resource.data.lotteryId).ownerId
        && request.resource.data.campsiteId in offer(request.resource.data.offerId).campsiteIds
        && request.resource.data.campsiteId in lottery(request.resource.data.lotteryId).campsiteIds
        && campsite(request.resource.data.campsiteId).active == true
        && campsite(request.resource.data.campsiteId).ownerId == request.resource.data.ownerId
        && request.resource.data.guestCount <= campsite(request.resource.data.campsiteId).maxGuests
        && request.resource.data.totalPrice == campsite(request.resource.data.campsiteId).pricePerNight
          * ((request.resource.data.endDate.toMillis() - request.resource.data.startDate.toMillis()) / 86400000)
        && claimedOffer(request.resource.data.offerId, id)
        && request.resource.data.createdAt == request.time && updatedNow();
      // Entrants request cancellation; the foreground owner processor completes it and releases dates.
      allow update: if (mine(resource.data.userId) && resource.data.status == 'confirmed' && request.time < resource.data.endDate
        && resource.data.cancellationRequested == false && changedOnly(['cancellationRequested','updatedAt'])
        && request.resource.data.cancellationRequested == true && updatedNow())
        || (mine(resource.data.ownerId) && request.time < resource.data.endDate
          && changedOnly(['status','updatedAt']) && updatedNow()
          && resource.data.status in ['requested','confirmed'] && request.resource.data.status == 'rejected')
        || (mine(resource.data.ownerId) && resource.data.status == 'requested' && request.resource.data.status == 'rejected'
          && changedOnly(['status','updatedAt']) && updatedNow()
          && offer(resource.data.offerId).reservationId == id && offer(resource.data.offerId).response == 'accept'
          && getAfter(/databases/$(database)/documents/offers/$(resource.data.offerId)).data.response == null)
        || (mine(resource.data.ownerId) && changedOnly(['status','updatedAt']) && updatedNow()
          && bookingConfirmed(id) && eligibleBooking(resource.data))
        || (mine(resource.data.ownerId) && changedOnly(['status','cancellationRequested','updatedAt']) && updatedNow()
          && bookingReleased(id) && resource.data.status == 'confirmed' && request.resource.data.status == 'cancelled')
        || (mine(resource.data.ownerId) && resource.data.status == 'rejected' && request.resource.data.status == 'rejected'
          && changedOnly(['cancellationRequested','updatedAt']) && request.resource.data.cancellationRequested == false && updatedNow());
      allow delete: if false;
    }
    // Immutable, owner-scoped idempotency records. Empty replacement decisions also close a decline once.
    match /offerReplacements/{id} {
      allow get: if mine(lottery(offer(id).lotteryId).ownerId);
      allow create: if replacementCommitted(id)
        && request.resource.data.keys().hasAll(['lotteryId','declinedOfferId','replacementUserId','replacementOfferId','processedAt'])
        && request.resource.data.keys().hasOnly(['lotteryId','declinedOfferId','replacementUserId','replacementOfferId','processedAt'])
        && ((request.resource.data.replacementUserId == null && request.resource.data.replacementOfferId == null)
          || replacementWinner(id, request.resource.data.replacementUserId, request.resource.data.lotteryId));
      allow list, update, delete: if false;
    }
    match /reservationReleases/{id} {
      allow get: if mine(bookingBefore(id).ownerId);
      allow create: if mine(bookingBefore(id).ownerId) && bookingBefore(id).status == 'rejected'
        && request.resource.data.keys().hasAll(['reservationId','processedAt'])
        && request.resource.data.keys().hasOnly(['reservationId','processedAt'])
        && request.resource.data.reservationId == id && request.resource.data.processedAt == request.time;
      allow list, update, delete: if false;
    }
    match /bookedNights/{id} {
      allow read: if activeUser();
      allow create: if request.resource.data.keys().hasAll(['campsiteId','reservationId','date'])
        && request.resource.data.keys().hasOnly(['campsiteId','reservationId','date'])
        && id == request.resource.data.campsiteId + '_' + request.resource.data.date
        && request.resource.data.campsiteId == bookingBefore(request.resource.data.reservationId).campsiteId
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.date in campsite(request.resource.data.campsiteId).availableNights
        && timestamp.date(int(request.resource.data.date.split('-')[0]), int(request.resource.data.date.split('-')[1]),
          int(request.resource.data.date.split('-')[2])) >= bookingBefore(request.resource.data.reservationId).startDate
        && timestamp.date(int(request.resource.data.date.split('-')[0]), int(request.resource.data.date.split('-')[1]),
          int(request.resource.data.date.split('-')[2])) < bookingBefore(request.resource.data.reservationId).endDate
        && bookingConfirmed(request.resource.data.reservationId);
      allow delete: if bookingReleased(resource.data.reservationId)
        && resource.data.campsiteId == bookingBefore(resource.data.reservationId).campsiteId;
      allow update: if false;
    }
    match /notifications/{id} {
      allow read: if mine(resource.data.toUserId) || admin();
      allow create: if ((localResult(request.resource.data, id) || replacementResult(request.resource.data, id))
        && request.resource.data.keys().hasAll(['type','toUserId','lotteryId','offerId','createdAt'])
        && request.resource.data.keys().hasOnly(['type','toUserId','lotteryId','offerId','createdAt']))
        || bookingNotice(request.resource.data, id);
      allow update: if mine(resource.data.toUserId) && changedOnly(['read','updatedAt'])
        && request.resource.data.read is bool && updatedNow();
      allow delete: if false;
    }
    match /conversations/{id} {
      allow read: if participant(resource.data) || admin();
      allow create: if activeUser() && request.resource.data.entrantId == request.auth.uid
        && request.resource.data.keys().hasAll(['campsiteId','lotteryId','reservationId','entrantId','ownerId','lastMessage','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['campsiteId','lotteryId','reservationId','entrantId','ownerId','lastMessage','createdAt','updatedAt'])
        && request.resource.data.ownerId == campsite(request.resource.data.campsiteId).ownerId
        && request.resource.data.entrantId != request.resource.data.ownerId && campsite(request.resource.data.campsiteId).active
        && request.resource.data.lastMessage == ''
        && (request.resource.data.lotteryId == null || (lottery(request.resource.data.lotteryId).ownerId == request.resource.data.ownerId
          && request.resource.data.campsiteId in lottery(request.resource.data.lotteryId).campsiteIds))
        && (request.resource.data.reservationId == null || (get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.campsiteId == request.resource.data.campsiteId))
        && request.resource.data.createdAt == request.time && updatedNow();
      // lastMessage is a display preview; participants cannot change membership.
      allow update: if participant(resource.data) && changedOnly(['lastMessage','updatedAt'])
        && text(request.resource.data.lastMessage, 4000) && updatedNow();
      allow delete: if false;
    }
    match /messages/{id} {
      allow read: if participant(chat(resource.data.conversationId)) || admin();
      allow create: if activeUser() && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasAll(['conversationId','senderId','receiverId','text','read','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['conversationId','senderId','receiverId','text','read','createdAt','updatedAt'])
        && participant(chat(request.resource.data.conversationId))
        && request.resource.data.receiverId in [chat(request.resource.data.conversationId).entrantId, chat(request.resource.data.conversationId).ownerId]
        && request.resource.data.receiverId != request.auth.uid
        && text(request.resource.data.text, 4000) && request.resource.data.text.size() > 0
        && request.resource.data.read == false && request.resource.data.createdAt == request.time && updatedNow();
      allow update: if mine(resource.data.receiverId) && participant(chat(resource.data.conversationId))
        && changedOnly(['read','updatedAt']) && request.resource.data.read == true && updatedNow();
      allow delete: if false;
    }
    match /photos/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId','targetType','targetId','imageBase64','mimeType','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerId','targetType','targetId','imageBase64','mimeType','createdAt','updatedAt'])
        && text(request.resource.data.imageBase64, 280000) && request.resource.data.imageBase64.size() > 0
        && request.resource.data.mimeType in ['image/jpeg','image/webp','image/png']
        && ((request.resource.data.targetType == 'user' && request.resource.data.targetId == request.auth.uid)
          || (request.resource.data.targetType == 'campsite' && campsite(request.resource.data.targetId).ownerId == request.auth.uid))
        && request.resource.data.createdAt == request.time && updatedNow();
      allow update: if false;
      allow delete: if mine(resource.data.ownerId) || admin();
    }
    match /ratings/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid
        && id == request.resource.data.campsiteId + '_' + request.auth.uid
        && request.resource.data.keys().hasAll(['campsiteId','userId','score','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['campsiteId','userId','score','createdAt','updatedAt'])
        && campsite(request.resource.data.campsiteId).active
        && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5
        && request.resource.data.createdAt == request.time && updatedNow();
      allow update: if mine(resource.data.userId) && changedOnly(['score','updatedAt'])
        && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5 && updatedNow();
      allow delete: if mine(resource.data.userId) || admin();
    }
    match /ownerNotices/{id} {
      allow read: if mine(resource.data.ownerId)
        || (activeUser() && request.auth.uid in resource.data.recipientIds) || admin();
      allow create: if activeUser() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId','lotteryId','message','recipientIds','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerId','lotteryId','message','recipientIds','createdAt','updatedAt'])
        && lottery(request.resource.data.lotteryId).ownerId == request.auth.uid
        && text(request.resource.data.message, 1000) && request.resource.data.message.size() > 0
        && request.resource.data.recipientIds is list && request.resource.data.recipientIds.size() >= 1
        && request.resource.data.recipientIds.size() <= 100 && request.resource.data.createdAt == request.time && updatedNow();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
